{
  "name": "Inspire FM 105.1",
  "short_name": "Inspire FM",
  "description": "Luton's community radio: listen live, prayer times with adhan alerts, Jummah finder, duas and what's on.",
  "id": "/",
  "start_url": "/?source=app",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0f1113",
  "theme_color": "#0f1113",
  "categories": ["music", "lifestyle", "news"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Listen live", "url": "/#listen", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Prayer times", "url": "/#prayer", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Jummah finder", "url": "/#jummah", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
