# SMR website: open the static site first (ahead of the old WordPress install)
DirectoryIndex index.html

# Cache images and fonts for a week, pages briefly
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 5 minutes"
  ExpiresByType image/webp "access plus 7 days"
  ExpiresByType image/png "access plus 7 days"
  ExpiresByType image/jpeg "access plus 7 days"
  ExpiresByType application/javascript "access plus 1 day"
</IfModule>

# Private app demo links: /app-demo/<app-name>/<token> (handled by the demo showroom)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^app-demo/[a-z0-9-]+/([A-Za-z0-9_-]{16,64})/?$ demo/index.php?k=$1 [L,QSA]
</IfModule>

# smrgraphics.co.uk/plates opens the Plates page
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^plates/$ /plates [R=301,L]
  RewriteRule ^plates$ index.html [L]
</IfModule>
